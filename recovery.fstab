# mount point  fstype  device                                       flags
/boot         emmc     /dev/block/bootdevice/by-name/boot         flags=display=boot;backup=1
/recovery     emmc     /dev/block/bootdevice/by-name/recovery     flags=display=recovery;backup=1
/system       ext4     /dev/block/bootdevice/by-name/system       flags=display=system;backup=1
/vendor       ext4     /dev/block/bootdevice/by-name/vendor       flags=display=vendor;backup=1
/odm          ext4     /dev/block/bootdevice/by-name/odm          flags=display=odm;backup=1
/preload      ext4     /dev/block/bootdevice/by-name/hidden       flags=display=preload
/cache        ext4     /dev/block/bootdevice/by-name/cache        flags=display=cache
/data         ext4     /dev/block/bootdevice/by-name/userdata     flags=display=data;encryptable=footer;length=-16384
/efs          ext4     /dev/block/bootdevice/by-name/efs          flags=display=efs;backup=1
/persist      ext4     /dev/block/bootdevice/by-name/persist      flags=display=persist;backup=1
/modem        emmc     /dev/block/bootdevice/by-name/apnhlos      flags=display=modem;backup=1
/mdm          emmc     /dev/block/bootdevice/by-name/modem        flags=display=mdm;backup=1
/dsp          emmc     /dev/block/bootdevice/by-name/dsp          flags=display=dsp;backup=1
/misc         emmc     /dev/block/bootdevice/by-name/misc         flags=display=misc
/external_sd  auto     /dev/block/mmcblk1p1    /dev/block/mmcblk1   flags=display="MicroSD";storagename="External SD";removable
/usb_otg      auto     /dev/block/sda1         /dev/block/sda       flags=display="USB OTG";storagename="USB OTG";removable

+/* Android 10 (sdk >= 29) stock binaries (vold, HALs, vdc) use /system/bin/linker -> /apex/com.android.runtime/bin/linker
+ * and libc from the runtime APEX. The recovery has no apexd, so bind-mount the flattened runtime APEX of the
+ * installed system while vold_decrypt is running. */
+static bool Mount_Runtime_Apex(void) {
+	if (sdkver < 29)
+		return false;
+	mkdir("/apex", 0755);
+	mkdir("/apex/com.android.runtime", 0755);
+	umount2("/apex/com.android.runtime", MNT_DETACH); // never stack mounts
+	if (mount("/system/apex/com.android.runtime.release", "/apex/com.android.runtime", NULL, MS_BIND, NULL) != 0) {
+		LOGERROR("Failed to bind-mount the runtime APEX: %s\n", strerror(errno));
+		return false;
+	}
+	LOGINFO("Runtime APEX mounted for the stock vold.\n");
+	return true;
+}
+
+static void Unmount_Runtime_Apex(void) {
+	umount2("/apex/com.android.runtime", MNT_DETACH);
+}

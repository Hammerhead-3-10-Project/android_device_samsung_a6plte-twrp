+#ifdef TW_INCLUDE_LIBRESETPROP
+/* Samsung's sKeymaster (MDFPP) only provides the Root of Trust (integrity/lock/boot state) to the
+ * secure world on "user" builds; on eng/userdebug it logs "invalid rot just set 0" and the key of the
+ * ODE footer cannot be unwrapped. Present the recovery as a user build while vold_decrypt runs. */
+static void Override_Build_Prop(const char* key, const std::string& value, const char* backup_key) {
+	char cur[PROPERTY_VALUE_MAX];
+	property_get(key, cur, "");
+	if (value == cur) {
+		property_set(backup_key, "");
+		return;
+	}
+	property_set(backup_key, cur);
+	int error = TWFunc::Property_Override(key, value);
+	if (error)
+		LOGERROR("Property override of %s failed, code %d\n", key, error);
+	else
+		LOGINFO("Property %s overridden: %s -> %s\n", key, cur, value.c_str());
+}
+
+static void Restore_Build_Prop(const char* key, const char* backup_key) {
+	char orig[PROPERTY_VALUE_MAX];
+	property_get(backup_key, orig, "");
+	if (orig[0] == '\0')
+		return;
+	if (TWFunc::Property_Override(key, std::string(orig)) == 0)
+		LOGINFO("Property %s restored to %s\n", key, orig);
+	property_set(backup_key, "");
+}
+
+static void Update_Build_Type(void) {
+	char fb[PROPERTY_VALUE_MAX];
+	property_get("ro.boot.fastboot", fb, "error");
+	if (strcmp(fb, "error") != 0 || sdkver < 26)
+		return;
+	std::string type = TWFunc::System_Property_Get("ro.build.type");
+	if (type.empty())
+		type = "user";
+	Override_Build_Prop("ro.build.type", type, "vold_decrypt.buildtype_orig");
+	Override_Build_Prop("ro.debuggable", "0", "vold_decrypt.debuggable_orig");
+}
+
+static void Revert_Build_Type(void) {
+	Restore_Build_Prop("ro.build.type", "vold_decrypt.buildtype_orig");
+	Restore_Build_Prop("ro.debuggable", "vold_decrypt.debuggable_orig");
+}
+#endif
+
+/* Android 10 (sdk >= 29) stock binaries (vold, HALs, vdc) use /system/bin/linker -> /apex/com.android.runtime/bin/linker
+ * and libc from the runtime APEX. The recovery has no apexd, so bind-mount the flattened runtime APEX of the
+ * installed system while vold_decrypt is running. */
+static bool Mount_Runtime_Apex(void) {
+	if (sdkver < 29)
+		return false;
+	mkdir("/apex", 0755);
+	mkdir("/apex/com.android.runtime", 0755);
+	umount2("/apex/com.android.runtime", MNT_DETACH); // never stack mounts
+	if (mount("/system/apex/com.android.runtime.release", "/apex/com.android.runtime", NULL, MS_BIND, NULL) != 0) {
+		LOGERROR("Failed to bind-mount the runtime APEX: %s\n", strerror(errno));
+		return false;
+	}
+	LOGINFO("Runtime APEX mounted for the stock vold.\n");
+	return true;
+}
+
+static void Unmount_Runtime_Apex(void) {
+	umount2("/apex/com.android.runtime", MNT_DETACH);
+}
+
+/* The Samsung MDFPP keymaster (and the other TrustZone apps) load their trustlets from
+ * /vendor/firmware_mnt/image (apnhlos partition, mounted by init.target.rc on a stock boot).
+ * Without them QSEECom_start_app fails (error -49) and the ODE key manager gets a zero Root of Trust. */
+static bool Mount_Firmware_Trustlets(void) {
+	if (TWFunc::Path_Exists("/vendor/firmware_mnt/image"))
+		return false; // already available
+	mkdir("/vendor/firmware_mnt", 0755);
+	umount2("/vendor/firmware_mnt", MNT_DETACH);
+	if (mount("/dev/block/bootdevice/by-name/apnhlos", "/vendor/firmware_mnt", "vfat", MS_RDONLY,
+			"shortname=lower,uid=0,gid=1000,dmask=227,fmask=337") != 0) {
+		LOGERROR("Failed to mount apnhlos on /vendor/firmware_mnt: %s\n", strerror(errno));
+		return false;
+	}
+	LOGINFO("Firmware trustlets mounted on /vendor/firmware_mnt.\n");
+	return true;
+}
+
+static void Unmount_Firmware_Trustlets(void) {
+	umount2("/vendor/firmware_mnt", MNT_DETACH);
+}

# Device specific recovery init for a6plte (SM-A605FN)
# NOTE: the stock kernel has CONFIG_USB_CONFIGFS unset (android_usb only), so the
# configfs gadget setup of the stock recovery is dropped: TWRP's own
# init.recovery.usb.rc drives /sys/class/android_usb instead.

on init
    # hw_get_module() picks keystore.msm8953.so / gatekeeper.msm8953.so from this property;
    # without it the stock keymaster HAL falls back to a software implementation and gatekeeper crashes
    setprop ro.board.platform msm8953
    # Panel backlight is /sys/class/leds/lcd-backlight (max 365); /sys/class/backlight/panel has max 0
    write /sys/class/leds/lcd-backlight/brightness 200

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# Debug: dump kernel/TWRP status into /cache so it can be read from Android with root
service twrp_dbg /sbin/sh /sbin/twrp_dbg.sh
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot
    disabled

# The debug service is not started by default (it reboots the phone after ~50 s).
# To use it again: add "start twrp_dbg" to an "on boot" block.

# Android 10 binaries (vold, HALs) need the bionic linker and libc from the runtime APEX:
# /system/bin/linker -> /apex/com.android.runtime/bin/linker. The recovery has no apexd, so
# bind-mount the flattened runtime APEX of the installed system right before vold_decrypt starts
# the services (vold_decrypt sets this property while it prepares the stock system).
on property:vold_decrypt.symlinked_firmware=*
    mkdir /apex 0755 root root
    mkdir /apex/com.android.runtime 0755 root root
    mount none /system/apex/com.android.runtime.release /apex/com.android.runtime bind
